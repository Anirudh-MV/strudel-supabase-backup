{
  "manifest_version": 3,
  "name": "Strudel Session Sync",
  "version": "0.7.3",
  "description": "Backs up your strudel.cc editor to your own Supabase project as versioned history, with one-click restore of any saved version.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://strudel.cc/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://strudel.cc/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Strudel Session Sync"
  }
}